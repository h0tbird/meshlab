{
  "servers": {
    "grafana": {
      "type": "stdio",
      "command": "mcp-grafana",
      "env": {
        "GRAFANA_URL": "http://127.0.0.1:8084"
      }
    },
    "prometheus": {
      "type": "stdio",
      "command": "prometheus-mcp-server",
      "env": {
        "PROMETHEUS_MCP_SERVER_PROMETHEUS_URL": "http://127.0.0.1:8083",
        "PROMETHEUS_MCP_SERVER_WEB_LISTEN_ADDRESS": "127.0.0.1:19464"
      }
    }
  }
}
