#!/bin/bash
#
# Reproduces and measures the istiod memory leak triggered by re-tokening the
# multicluster remote secret. Changing the token changes the kubeconfig SHA, so
# istiod treats it as a cluster Update and rebuilds the whole remote-cluster
# stack (new kube.Client, informers, ~25 KRT collections). The teardown is
# incomplete, so each rotation leaks heap and goroutines.
#
# See docs/issues/istiod-retoken-memory-leak.md for the analysis.
#
#   Usage: retoken [patch|recreate]
#
# Knobs (environment):
#   SRC_CLUSTER    cluster holding the remote secret       (pasta-1)
#   DST_CLUSTER    cluster the remote secret points at     (pasta-2)
#   ITERATIONS     number of re-tokenings                  (200)
#   INTERVAL       seconds to wait between re-tokenings    (5)
#   SAMPLE_EVERY   sample every N re-tokenings             (10)
#   PROFILE        collect pprof profiles                  (true)
#   OUTDIR         where samples and metrics.csv land      (/tmp/retoken-<ts>)
#   DEBUG_PORT     local port forwarded to istiod :8080    (first free >= 9090)
#   METRICS_PORT   local port forwarded to istiod :15014   (first free above it)
#
# Quick smoke test (~1 min), enough to see the trend:
#   ITERATIONS=20 SAMPLE_EVERY=5 INTERVAL=2 retoken

set -euo pipefail

SRC_CLUSTER="${SRC_CLUSTER:-pasta-1}"
DST_CLUSTER="${DST_CLUSTER:-pasta-2}"
ITERATIONS="${ITERATIONS:-200}"
INTERVAL="${INTERVAL:-5}"
SAMPLE_EVERY="${SAMPLE_EVERY:-10}"
PROFILE="${PROFILE:-${HEAP_PROFILE:-true}}"
OUTDIR="${OUTDIR:-/tmp/retoken-$(date -u +%Y%m%dT%H%M%SZ)}"
DEBUG_PORT="${DEBUG_PORT:-}"
METRICS_PORT="${METRICS_PORT:-}"

SRC="kubectl --context kind-${SRC_CLUSTER} -n istio-system"
DST="kubectl --context kind-${DST_CLUSTER} -n istio-system"
SECRET="istio-remote-secret-${DST_CLUSTER}"

#------------------------------------------------------------------------------
# Implementation 1: Patch the existing secret (default)
#-------------------------------------------------------------------------------

retoken_patch () {
  # New KUBECONFIG for ${DST_CLUSTER} with updated token
  KUBECONFIG_B64=$(${SRC} get secret "${SECRET}" -o yaml | yq ".data.${DST_CLUSTER}" |
  base64 -d | yq ".users[0].user.token = \"$(${DST} create token istio-reader-service-account)\"" | base64 -w0)

  # Edit secret ${SECRET} in ${SRC_CLUSTER}
  ${SRC} patch secret "${SECRET}" -p "{\"data\":{\"${DST_CLUSTER}\":\"${KUBECONFIG_B64}\"}}" >/dev/null
}

#------------------------------------------------------------------------------
# Implementation 2: Delete and recreate the secret
#-------------------------------------------------------------------------------

retoken_recreate () {
  # Get the current secret as YAML
  SECRET_YAML=$(${SRC} get secret "${SECRET}" -o yaml)

  # Extract and update the KUBECONFIG with a new token
  KUBECONFIG_B64=$(echo "$SECRET_YAML" | yq ".data.${DST_CLUSTER}" |
  base64 -d | yq ".users[0].user.token = \"$(${DST} create token istio-reader-service-account)\"" | base64 -w0)

  # Delete the existing secret
  ${SRC} delete secret "${SECRET}" >/dev/null

  # Recreate the secret with updated token (strip resourceVersion and other metadata)
  echo "$SECRET_YAML" | yq ".data.${DST_CLUSTER} = \"$KUBECONFIG_B64\" | del(.metadata.resourceVersion) | del(.metadata.uid) | del(.metadata.creationTimestamp)" |
  ${SRC} apply -f - >/dev/null
}

#------------------------------------------------------------------------------
# Telemetry
#-------------------------------------------------------------------------------

# Prints the first free local TCP port at or above $1.
free_port () {
  local port=$1
  while ss -ltnH "sport = :${port}" | grep -q .; do
    port=$(( port + 1 ))
  done
  echo "${port}"
}

# Forwards istiod's debug (8080) and monitoring (15014) ports, tearing the
# forward down on exit. Tilt and friends squat on the usual ports, so pick free
# ones and confirm the far end really is istiod before trusting any sample.
start_port_forward () {
  DEBUG_PORT="${DEBUG_PORT:-$(free_port 9090)}"
  METRICS_PORT="${METRICS_PORT:-$(free_port $(( DEBUG_PORT + 1 )))}"

  ${SRC} port-forward --address 127.0.0.1 "deploy/${ISTIOD}" \
    "${DEBUG_PORT}:8080" "${METRICS_PORT}:15014" >"${OUTDIR}/port-forward.log" 2>&1 &
  PF_PID=$!
  trap 'kill ${PF_PID} 2>/dev/null || true' EXIT

  for _ in {1..30}; do
    if curl -sf "http://127.0.0.1:${METRICS_PORT}/metrics" | grep -q '^go_goroutines '; then
      echo "port-forward: debug ${DEBUG_PORT}->8080, monitoring ${METRICS_PORT}->15014"
      return 0
    fi
    sleep 1
  done

  echo "error: no istiod metrics on 127.0.0.1:${METRICS_PORT}, see ${OUTDIR}/port-forward.log" >&2
  exit 1
}

# Prints "<goroutines> <heap_inuse_bytes> <rss_bytes>".
read_metrics () {
  curl -sf "http://127.0.0.1:${METRICS_PORT}/metrics" | awk '
    $1 == "go_goroutines"                  { g = $2 }
    $1 == "go_memstats_heap_inuse_bytes"   { h = $2 }
    $1 == "process_resident_memory_bytes"  { r = $2 }
    END { printf "%.0f %.0f %.0f\n", g+0, h+0, r+0 }'
}

# Records one CSV row and, when profiling, one heap and one goroutine profile.
take_sample () {
  local sample=$1 iteration=$2 elapsed=${SECONDS}

  read -r goroutines heap rss <<<"$(read_metrics)"
  printf '%s,%s,%s,%s,%s,%s\n' \
    "${sample}" "${iteration}" "${elapsed}" "${goroutines}" "${heap}" "${rss}" >>"${OUTDIR}/metrics.csv"

  awk -v s="${sample}" -v i="${iteration}" -v t="${elapsed}" -v g="${goroutines}" -v h="${heap}" -v r="${rss}" \
    'BEGIN{printf "sample %-3s iteration %-4s %5ss  goroutines %-6s heap %6.1f MB  rss %6.1f MB\n", s, i, t, g, h/1048576, r/1048576}'

  if [[ "${PROFILE}" == "true" ]]; then
    curl -sf "http://127.0.0.1:${DEBUG_PORT}/debug/pprof/heap?gc=1" > "${OUTDIR}/heap.sample-${sample}.pb.gz"
    curl -sf "http://127.0.0.1:${DEBUG_PORT}/debug/pprof/goroutine" > "${OUTDIR}/goroutine.sample-${sample}.pb.gz"
  fi
}

# Derives the per-rotation leak rate from the first and last CSV rows.
summarize () {
  local last_sample=$1

  echo
  [[ "$(${SRC} get pods -l app=istiod -o jsonpath='{.items[0].metadata.name}')" == "${POD}" ]] ||
    echo "WARNING: istiod restarted during the run, the numbers below are not comparable"

  awk -F, 'NR==2{fi=$2;fg=$4;fh=$5} END{
    di=$2-fi; if (di<1) di=1
    printf "rotations:   %d\n", di
    printf "goroutines:  %d -> %d  (%+.1f per rotation)\n", fg, $4, ($4-fg)/di
    printf "heap inuse:  %.1f MB -> %.1f MB  (%+.2f MB per rotation)\n", fh/1048576, $5/1048576, ($5-fh)/1048576/di
  }' "${OUTDIR}/metrics.csv"

  [[ "${PROFILE}" == "true" ]] || return 0
  cat <<EOF

Samples and metrics.csv are in ${OUTDIR}

  go tool pprof -http=:9999 -diff_base ${OUTDIR}/heap.sample-0.pb.gz ${OUTDIR}/heap.sample-${last_sample}.pb.gz
  go tool pprof -inuse_space -top -nodecount=25 ${OUTDIR}/heap.sample-${last_sample}.pb.gz
  go tool pprof -peek 'NewTypedRingGrowing' ${OUTDIR}/heap.sample-${last_sample}.pb.gz
  go tool pprof -top -diff_base ${OUTDIR}/goroutine.sample-0.pb.gz ${OUTDIR}/goroutine.sample-${last_sample}.pb.gz
EOF
}

#------------------------------------------------------------------------------
# Entry Point
#-------------------------------------------------------------------------------

# Validate the retoken function exists
RETOKEN="retoken_${1:-patch}"
if ! declare -f "${RETOKEN}" > /dev/null; then
  echo "Usage: $0 [patch|recreate]"
  exit 1
fi

ISTIOD=$(${SRC} get deploy -l app=istiod -o jsonpath='{.items[0].metadata.name}')
POD=$(${SRC} get pods -l app=istiod -o jsonpath='{.items[0].metadata.name}')
[[ -n "${ISTIOD}" ]] || { echo "error: no istiod deployment in kind-${SRC_CLUSTER}" >&2; exit 1; }

mkdir -p "${OUTDIR}"
echo "sample,iteration,elapsed_s,goroutines,heap_inuse_bytes,rss_bytes" >"${OUTDIR}/metrics.csv"

echo "${RETOKEN}: ${ITERATIONS} rotations every ${INTERVAL}s against ${ISTIOD}/${POD} in kind-${SRC_CLUSTER}"
echo "output: ${OUTDIR}"
echo

start_port_forward
SECONDS=0
take_sample 0 0

sample=1
for i in $(seq 1 "${ITERATIONS}"); do
  ${RETOKEN}
  sleep "${INTERVAL}"
  if (( i % SAMPLE_EVERY == 0 )); then
    take_sample "${sample}" "${i}"
    sample=$(( sample + 1 ))
  fi
done

summarize "$(( sample - 1 ))"
